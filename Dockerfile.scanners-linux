FROM aquasec/trivy:0.76.1@sha256:2e6c00d711ab4ae41d8a30c2c1fd3bd3b62704c177bb120f95012e939edfb3df AS trivy
FROM python:3.12.13-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
LABEL agentports.project="m4"
COPY pins/core-requirements.txt /opt/m4/pins/core-requirements.txt
COPY pins/checkov.requirements.txt /opt/m4/pins/checkov.requirements.txt
RUN python -m venv /opt/m4-core && /opt/m4-core/bin/python -m pip --isolated install --no-cache-dir --only-binary=:all: --require-hashes -r /opt/m4/pins/core-requirements.txt
RUN python -m venv /opt/m4-checkov && /opt/m4-checkov/bin/python -m pip --isolated install --no-cache-dir --only-binary=:all: --require-hashes -r /opt/m4/pins/checkov.requirements.txt
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY product /opt/m4/product
COPY policies /opt/m4/policies
COPY cache-seed /opt/m4/cache-seed
COPY pins /opt/m4/pins
ENV PYTHONPATH=/opt/m4/product/src:/opt/m4/product PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 HOME=/tmp/m4-home TMPDIR=/tmp
USER 65532:65532
WORKDIR /opt/m4/product
# Fixed metadata/test entrypoint; no primary scanner commands or plan inputs.
ENTRYPOINT ["/opt/m4-core/bin/python", "-B", "/opt/m4/product/evals/scanners/linux_readiness.py"]
